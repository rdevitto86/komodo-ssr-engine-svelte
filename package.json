{
  "name": "komodo-ssr-engine-svelte",
  "version": "0.1.0",
  "private": true,
  "description": "Svelte SSR rendering API for Komodo platforms",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "keywords": [
    "svelte",
    "ssr",
    "server-side-rendering",
    "vite",
    "bun"
  ],
  "scripts": {
    "dev": "vite dev",
    "start": "bun run build/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "bootstrap": "bun install && bun run build",
    "up": "bun update --latest",
    "fresh": "bun run clean && bun install",
    "clean": "rm -rf node_modules bun.lock",
    "gen:types": "bun run scripts/gen-types.ts",
    "test": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1080.0",
    "@aws-sdk/client-s3": "^3.1080.0",
    "@komodo-forge-sdk/typescript": "github:rdevitto86/komodo-forge-sdk-ts",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "svelte": "^5.56.4",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}